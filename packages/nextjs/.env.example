# Template for NextJS environment variables (packages/nextjs/.env.example)

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables

# REQUIRED (if using public networks): Your Alchemy API key for accessing Ethereum networks
# • Optional for purely local development (anvil/foundry only)
# • Sign up at https://www.alchemy.com/ and create a new API key
NEXT_PUBLIC_ALCHEMY_API_KEY=

# REQUIRED: Your Privy project ID from console/dashboard
# • Create a Privy account and project to enable social login + wallets
# • Visit https://dashboard.privy.io/apps/[YOUR-PROJECT-ID]/login-methods and enable
#   "Ethereum wallets" and any social login methods you want to support
NEXT_PUBLIC_PRIVY_APP_ID=

# Supabase (Privy-auth + RLS)
# • Project URL: https://<PROJECT_ID>.supabase.co (Settings → API)
# • Publishable/Anon key: from Settings → API (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=

# SERVER-ONLY: Private key to mint Supabase JWTs for RLS when exchanging Privy tokens
# Where to get it:
#   • In your Supabase Dashboard: Settings → API → JWT Signing Keys
#   • Enable asymmetric signing keys (RS256 recommended). Copy the PRIVATE key.
# Usage:
#   • Used by Server Actions to sign short-lived Supabase JWTs for your app (never sent to clients).
#   • DO NOT prefix with NEXT_PUBLIC_. Keep this value private and out of client bundles.
# Format:
#   • Paste the PEM as-is with BEGIN/END lines and real newlines in .env.local, e.g.:
#       -----BEGIN PRIVATE KEY-----
#       ...
#       -----END PRIVATE KEY-----
#   • Many hosts (including Vercel) support multi-line secrets. If your host does not,
#     you can store it as a single line with \n escapes and update the signing code to replace
#     /\\n/g with newlines before importing the key.
# Algorithm:
#   • Our code supports RS256 or ES256 and reads SUPABASE_JWT_ALG (defaults to ES256).
#   • Ensure this matches your Supabase project's JWKS key type (RSA for RS256, EC P-256 for ES256).
# Security:
#   • Never commit real keys. Use local .env files and platform secret managers.
#   • Store this only in server env (e.g., Vercel Project → Settings → Environment Variables).
SUPABASE_JWT_PRIVATE_KEY=

# Optional signing config (must match your Supabase JWKS)
#   • SUPABASE_JWT_ALG: RS256 | ES256 (default: ES256)
#   • SUPABASE_JWT_KID: kid from your Supabase JWKS key (recommended if multiple keys)
SUPABASE_JWT_ALG=ES256
SUPABASE_JWT_KID=35708ed2-a2dd-4788-824c-38b83138f84d

# Tips
#   • If you have a JWK (JSON key), convert it to a PKCS#8 PEM using our helper:
#       yarn supabase:jwk-to-pem
#   • Example (EC P-256) kid from packages/supabase/out/signing_key.json:
#       SUPABASE_JWT_ALG=ES256
#       SUPABASE_JWT_KID=35708ed2-a2dd-4788-824c-38b83138f84d
#     Then set SUPABASE_JWT_PRIVATE_KEY to the PEM output from the conversion.

# SERVER-ONLY: Supabase Service Role key for admin operations (e.g., upserting users before a session exists)
# • Where: Supabase → Settings → API → Service Role Key
# • NEVER expose client-side. Use only on the server (Server Actions, edge/server functions)
SUPABASE_SERVICE_ROLE_KEY=